{
  "name": "@adaptive-ds/sharepoint",
  "version": "0.1.0",
  "description": "SharePoint files from the terminal and TypeScript: list, search, download, upload, mkdir and delete across all sites via Microsoft Graph, with app-only auth and Result-based errors.",
  "keywords": [
    "sharepoint",
    "microsoft-graph",
    "office365",
    "microsoft365",
    "onedrive",
    "document-library",
    "pnpjs",
    "cli",
    "typescript",
    "result",
    "valibot",
    "bun"
  ],
  "homepage": "https://github.com/david1gp/sharepoint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/sharepoint.git"
  },
  "bugs": {
    "url": "https://github.com/david1gp/sharepoint/issues"
  },
  "author": {
    "name": "David Siewert",
    "url": "https://david-siewert.com/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/david1gp"
  },
  "license": "MIT",
  "readme": "README.md",
  "type": "module",
  "private": false,
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sharepoint": "dist/cli.js"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test tests",
    "test:w": "bun test --watch tests",
    "test:e2e": "bun run e2e/sharepointE2eRun.ts",
    "type-check": "tsc --noEmit",
    "build": "rm -rf ./dist && tsc -p ./tsconfig.lib.json && chmod +x ./dist/cli.js",
    "deploy": "bash ./ops/deploy.sh",
    "release": "bash ./ops/release.sh",
    "format": "biome format --write src tests e2e package.json tsconfig.json tsconfig.lib.json biome.json bunfig.toml cliff.toml",
    "format:check": "biome format src tests e2e package.json tsconfig.json tsconfig.lib.json biome.json bunfig.toml cliff.toml"
  },
  "dependencies": {
    "@pnp/graph": "^4.21.0",
    "@pnp/nodejs": "^4.21.0",
    "@stricli/core": "^1.3.0"
  },
  "peerDependencies": {
    "@adaptive-ds/result": ">=0.6.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@adaptive-ds/result": "^0.6.0",
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3",
    "valibot": "^1.2.0"
  },
  "imports": {
    "#result": "@adaptive-ds/result"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
